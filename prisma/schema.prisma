// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  campaigns     Campaign[]
  programAdmins ProgramAdmin[]

  @@map("organizations")
}

model ProgramAdmin {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String       @map("password_hash")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("program_admins")
}

model Campaign {
  id             String       @id @default(uuid())
  name           String
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  referralCodes  ReferralCode[]
  rewardRule     RewardRule?

  @@index([organizationId])
  @@map("campaigns")
}

enum RewardType {
  fixed
  percentage
}

model RewardRule {
  id         String     @id @default(uuid())
  campaignId String     @unique @map("campaign_id")
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  type       RewardType
  value      Decimal    @db.Decimal(10, 2)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("reward_rules")
}

model ReferralCode {
  id            String     @id @default(uuid())
  code          String     @unique
  campaignId    String     @map("campaign_id")
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  referrerEmail String     @map("referrer_email")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  referrals     Referral[]

  @@unique([campaignId, referrerEmail])
  @@index([campaignId])
  @@map("referral_codes")
}

enum ReferralStatus {
  pending
  converted
}

model Referral {
  id             String         @id @default(uuid())
  referralCodeId String         @map("referral_code_id")
  referralCode   ReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  refereeEmail   String         @map("referee_email")
  refereeName    String         @map("referee_name")
  status         ReferralStatus @default(pending)
  arr            Decimal?       @db.Decimal(10, 2) @map("arr")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  payout         Payout?

  @@unique([referralCodeId, refereeEmail])
  @@index([referralCodeId])
  @@map("referrals")
}

enum PayoutStatus {
  pending
  approved
  paid
}

model Payout {
  id         String       @id @default(uuid())
  referralId String       @unique @map("referral_id")
  referral   Referral     @relation(fields: [referralId], references: [id], onDelete: Restrict)
  amount     Decimal      @db.Decimal(10, 2)
  status     PayoutStatus @default(pending)
  approvedAt DateTime?    @map("approved_at")
  paidAt     DateTime?    @map("paid_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("payouts")
}
